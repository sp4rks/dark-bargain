{
  "manifest_version": 3,
  "name": "Dark Bargain",
  "description": "A calmer dark theme for OzBargain.",
  "version": "0.1.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "dark-bargain@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ozbargain.com.au/*",
        "https://ozbargain.com.au/*"
      ],
      "css": ["dark-bargain.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.ozbargain.com.au/node/*", "https://ozbargain.com.au/node/*"],
      "js": ["deal-page.js"],
      "run_at": "document_idle"
    }
  ]
}
